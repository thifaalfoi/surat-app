<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h3 class="fw-bold mb-0">Surat Masuk</h3>
    <p class="text-muted mb-0">Daftar surat masuk<% if (currentUser.role !== 'admin') { %> untuk bagian Anda<% } %></p>
  </div>
  <% if (currentUser.role === 'admin') { %>
    <a href="/surat-masuk/baru" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Input Surat Masuk</a>
  <% } %>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small mb-1">Cari</label>
        <input type="text" name="q" value="<%= filters.q %>" class="form-control form-control-sm" placeholder="No. surat, pengirim, atau perihal...">
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1">Status</label>
        <select name="status" class="form-select form-select-sm">
          <option value="">Semua Status</option>
          <option value="diproses" <%= filters.status === 'diproses' ? 'selected' : '' %>>Diproses</option>
          <option value="selesai" <%= filters.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
        </select>
      </div>
      <% if (currentUser.role === 'admin') { %>
      <div class="col-md-3">
        <label class="form-label small mb-1">Bagian Tujuan</label>
        <select name="bagian_id" class="form-select form-select-sm">
          <option value="">Semua Bagian</option>
          <% bagianList.forEach(b => { %>
            <option value="<%= b.id %>" <%= String(filters.bagian_id) === String(b.id) ? 'selected' : '' %>><%= b.nama_bagian %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="col-md-2">
        <button class="btn btn-sm btn-outline-secondary w-100" type="submit"><i class="bi bi-search me-1"></i>Filter</button>
      </div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>No. Surat</th>
          <th>Tanggal</th>
          <th>Pengirim</th>
          <th>Perihal</th>
          <% if (currentUser.role === 'admin') { %><th>Bagian Tujuan</th><% } %>
          <th>Status</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (items.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">Belum ada surat masuk.</td></tr>
        <% } %>
        <% items.forEach(s => { %>
          <tr>
            <td><%= s.nomor_surat %></td>
            <td><%= s.tanggal_surat %></td>
            <td><%= s.pengirim %></td>
            <td><%= s.perihal %></td>
            <% if (currentUser.role === 'admin') { %><td><%= bagianMap[s.bagian_tujuan_id] || '-' %></td><% } %>
            <td><span class="badge <%= s.status === 'selesai' ? 'bg-success' : 'bg-warning text-dark' %>"><%= s.status %></span></td>
            <td class="text-end">
              <a href="/surat-masuk/<%= s.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Detail</a>
              <% if (s.file_path) { %>
              <a href="/surat-masuk/<%= s.id %>/download" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i></a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
