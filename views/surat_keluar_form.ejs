<div class="mb-4">
  <h3 class="fw-bold mb-0"><%= suratMasukAsal ? 'Balas Surat' : 'Input Surat Keluar' %></h3>
  <% if (suratMasukAsal) { %>
    <p class="text-muted mb-0">Membalas surat masuk No. <%= suratMasukAsal.nomor_surat %> dari <%= suratMasukAsal.pengirim %> perihal "<%= suratMasukAsal.perihal %>"</p>
  <% } else { %>
    <p class="text-muted mb-0">Catat surat keluar baru.</p>
  <% } %>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <form action="/surat-keluar" method="POST" enctype="multipart/form-data">
      <% if (suratMasukAsal) { %>
        <input type="hidden" name="surat_masuk_id" value="<%= suratMasukAsal.id %>">
        <div class="alert alert-light border small mb-4">
          <i class="bi bi-reply-fill me-1"></i> Surat ini akan tertaut sebagai balasan, dan status surat masuk asal akan otomatis menjadi <strong>selesai</strong> setelah disimpan.
        </div>
      <% } %>

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Nomor Surat <span class="text-danger">*</span></label>
          <input type="text" name="nomor_surat" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Tanggal Surat <span class="text-danger">*</span></label>
          <input type="date" name="tanggal_surat" class="form-control" required value="<%= new Date().toISOString().slice(0,10) %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Tujuan / Penerima <span class="text-danger">*</span></label>
          <input type="text" name="tujuan" class="form-control" value="<%= suratMasukAsal ? suratMasukAsal.pengirim : '' %>" required>
        </div>
        <% if (currentUser.role === 'admin') { %>
        <div class="col-md-6">
          <label class="form-label">Atas Nama Bagian</label>
          <select name="bagian_id" class="form-select">
            <% bagianList.forEach(b => { %>
              <option value="<%= b.id %>" <%= suratMasukAsal && suratMasukAsal.bagian_tujuan_id === b.id ? 'selected' : '' %>><%= b.nama_bagian %></option>
            <% }) %>
          </select>
        </div>
        <% } %>
        <div class="col-12">
          <label class="form-label">Perihal <span class="text-danger">*</span></label>
          <input type="text" name="perihal" class="form-control" value="<%= suratMasukAsal ? 'RE: ' + suratMasukAsal.perihal : '' %>" required>
        </div>
        <div class="col-12">
          <label class="form-label">Upload File Surat (PDF)</label>
          <input type="file" name="file" accept="application/pdf" class="form-control">
          <div class="form-text">Maksimal 10MB, format PDF.</div>
        </div>
      </div>
      <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Simpan Surat Keluar</button>
        <a href="/surat-keluar" class="btn btn-outline-secondary">Batal</a>
      </div>
    </form>
  </div>
</div>
