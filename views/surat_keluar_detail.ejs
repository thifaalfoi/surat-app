<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
  <div>
    <a href="/surat-keluar" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left"></i> Kembali ke daftar</a>
    <h3 class="fw-bold mb-0 mt-1"><%= item.perihal %></h3>
    <span class="badge <%= item.status === 'selesai' ? 'bg-success' : 'bg-warning text-dark' %> mt-1"><%= item.status %></span>
  </div>
  <% if (item.file_path) { %>
    <a href="/surat-keluar/<%= item.id %>/download" class="btn btn-outline-secondary"><i class="bi bi-download me-1"></i>Unduh Surat</a>
  <% } %>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white fw-semibold">Detail Surat</div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tbody>
            <tr><th class="text-muted fw-normal" style="width:180px">Nomor Surat</th><td><%= item.nomor_surat %></td></tr>
            <tr><th class="text-muted fw-normal">Tanggal Surat</th><td><%= item.tanggal_surat %></td></tr>
            <tr><th class="text-muted fw-normal">Tujuan</th><td><%= item.tujuan %></td></tr>
            <tr><th class="text-muted fw-normal">Atas Nama Bagian</th><td><%= bagian ? bagian.nama_bagian : '-' %></td></tr>
            <tr><th class="text-muted fw-normal">Dibuat oleh</th><td><%= item.created_by_nama %></td></tr>
            <tr><th class="text-muted fw-normal">File</th><td><%= item.file_original_name || 'Tidak ada file' %></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">Ubah Status</div>
      <div class="card-body">
        <form action="/surat-keluar/<%= item.id %>/status" method="POST" class="d-flex gap-2">
          <select name="status" class="form-select">
            <option value="diproses" <%= item.status === 'diproses' ? 'selected' : '' %>>Diproses</option>
            <option value="selesai" <%= item.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
          </select>
          <button type="submit" class="btn btn-outline-primary">Perbarui</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <% if (suratMasukAsal) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold"><i class="bi bi-reply-fill me-1"></i>Balasan dari Surat Masuk</div>
      <div class="card-body">
        <a href="/surat-masuk/<%= suratMasukAsal.id %>" class="text-decoration-none">
          <div class="fw-semibold"><%= suratMasukAsal.perihal %></div>
          <div class="text-muted small">No. <%= suratMasukAsal.nomor_surat %> &middot; Dari: <%= suratMasukAsal.pengirim %></div>
        </a>
      </div>
    </div>
    <% } else { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body text-muted small">
        Surat ini dibuat langsung (bukan balasan dari surat masuk).
      </div>
    </div>
    <% } %>
  </div>
</div>
