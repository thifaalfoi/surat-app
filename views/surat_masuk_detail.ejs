<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
  <div>
    <a href="/surat-masuk" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left"></i> Kembali ke daftar</a>
    <h3 class="fw-bold mb-0 mt-1"><%= item.perihal %></h3>
    <span class="badge <%= item.status === 'selesai' ? 'bg-success' : 'bg-warning text-dark' %> mt-1"><%= item.status %></span>
  </div>
  <div class="d-flex gap-2">
    <% if (item.file_path) { %>
      <a href="/surat-masuk/<%= item.id %>/download" class="btn btn-outline-secondary"><i class="bi bi-download me-1"></i>Unduh Surat</a>
    <% } %>
    <a href="/surat-keluar/baru?balasan_dari=<%= item.id %>" class="btn btn-primary"><i class="bi bi-reply-fill me-1"></i>Balas Surat</a>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white fw-semibold">Detail Surat</div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tbody>
            <tr><th class="text-muted fw-normal" style="width:180px">Nomor Surat</th><td><%= item.nomor_surat %></td></tr>
            <tr><th class="text-muted fw-normal">Tanggal Surat</th><td><%= item.tanggal_surat %></td></tr>
            <tr><th class="text-muted fw-normal">Tanggal Diterima</th><td><%= item.tanggal_diterima %></td></tr>
            <tr><th class="text-muted fw-normal">Pengirim</th><td><%= item.pengirim %></td></tr>
            <tr><th class="text-muted fw-normal">Disposisi ke Bagian</th><td><%= bagian ? bagian.nama_bagian : '-' %></td></tr>
            <tr><th class="text-muted fw-normal">Dicatat oleh</th><td><%= item.created_by_nama %></td></tr>
            <tr><th class="text-muted fw-normal">File</th><td><%= item.file_original_name || 'Tidak ada file' %></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">Ubah Status</div>
      <div class="card-body">
        <form action="/surat-masuk/<%= item.id %>/status" method="POST" class="d-flex gap-2">
          <select name="status" class="form-select">
            <option value="diproses" <%= item.status === 'diproses' ? 'selected' : '' %>>Diproses</option>
            <option value="selesai" <%= item.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
          </select>
          <button type="submit" class="btn btn-outline-primary">Perbarui</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">Balasan / Surat Keluar Terkait</div>
      <ul class="list-group list-group-flush">
        <% if (balasanList.length === 0) { %>
          <li class="list-group-item text-muted small">Belum ada balasan untuk surat ini.</li>
        <% } %>
        <% balasanList.forEach(b => { %>
          <li class="list-group-item">
            <a href="/surat-keluar/<%= b.id %>" class="text-decoration-none d-flex justify-content-between">
              <div>
                <div class="fw-semibold small"><%= b.perihal %></div>
                <div class="text-muted" style="font-size:0.78rem">No. <%= b.nomor_surat %> &middot; Kepada: <%= b.tujuan %></div>
              </div>
              <span class="badge <%= b.status === 'selesai' ? 'bg-success' : 'bg-warning text-dark' %> align-self-start"><%= b.status %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
