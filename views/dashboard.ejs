<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-0">Dashboard</h3>
    <p class="text-muted mb-0">Ringkasan surat masuk &amp; keluar<%= isAdmin ? ' seluruh instansi' : ' bagian Anda' %></p>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body">
        <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-inbox-fill"></i></div>
        <div class="stat-num"><%= stats.totalMasuk %></div>
        <div class="stat-label">Total Surat Masuk</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body">
        <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-send-fill"></i></div>
        <div class="stat-num"><%= stats.totalKeluar %></div>
        <div class="stat-label">Total Surat Keluar</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body">
        <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-hourglass-split"></i></div>
        <div class="stat-num"><%= stats.masukDiproses + stats.keluarDiproses %></div>
        <div class="stat-label">Sedang Diproses</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body">
        <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-check-circle-fill"></i></div>
        <div class="stat-num"><%= stats.masukSelesai + stats.keluarSelesai %></div>
        <div class="stat-label">Selesai</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <% if (isAdmin) { %>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-semibold">Rekap per Bagian</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr><th>Bagian</th><th class="text-center">Surat Masuk</th><th class="text-center">Surat Keluar</th></tr>
          </thead>
          <tbody>
            <% perBagian.forEach(b => { %>
            <tr>
              <td><%= b.nama_bagian %></td>
              <td class="text-center"><%= b.masukCount %></td>
              <td class="text-center"><%= b.keluarCount %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } %>

  <div class="col-lg-<%= isAdmin ? 7 : 12 %>">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
        <span>Riwayat Aktivitas Terbaru</span>
        <% if (isAdmin) { %><a href="/aktivitas" class="small">Lihat semua &rarr;</a><% } %>
      </div>
      <ul class="list-group list-group-flush activity-list">
        <% if (recentActivity.length === 0) { %>
          <li class="list-group-item text-muted small">Belum ada aktivitas.</li>
        <% } %>
        <% recentActivity.forEach(log => { %>
          <li class="list-group-item small">
            <span class="fw-semibold"><%= log.user_nama %></span> &mdash; <%= log.detail %>
            <div class="text-muted" style="font-size:0.75rem"><%= new Date(log.created_at).toLocaleString('id-ID') %></div>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>

<div class="row g-3 mt-1">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold d-flex justify-content-between">
        <span>Surat Masuk Terbaru</span>
        <a href="/surat-masuk" class="small">Lihat semua &rarr;</a>
      </div>
      <ul class="list-group list-group-flush">
        <% if (recentMasuk.length === 0) { %><li class="list-group-item text-muted small">Belum ada data.</li><% } %>
        <% recentMasuk.forEach(s => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="/surat-masuk/<%= s.id %>" class="text-decoration-none">
              <div class="fw-semibold small"><%= s.perihal %></div>
              <div class="text-muted" style="font-size:0.78rem">No. <%= s.nomor_surat %> &middot; <%= s.pengirim %></div>
            </a>
            <span class="badge <%= s.status === 'selesai' ? 'bg-success' : 'bg-warning text-dark' %>"><%= s.status %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold d-flex justify-content-between">
        <span>Surat Keluar Terbaru</span>
        <a href="/surat-keluar" class="small">Lihat semua &rarr;</a>
      </div>
      <ul class="list-group list-group-flush">
        <% if (recentKeluar.length === 0) { %><li class="list-group-item text-muted small">Belum ada data.</li><% } %>
        <% recentKeluar.forEach(s => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="/surat-keluar/<%= s.id %>" class="text-decoration-none">
              <div class="fw-semibold small"><%= s.perihal %></div>
              <div class="text-muted" style="font-size:0.78rem">No. <%= s.nomor_surat %> &middot; <%= s.tujuan %></div>
            </a>
            <span class="badge <%= s.status === 'selesai' ? 'bg-success' : 'bg-warning text-dark' %>"><%= s.status %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
