<div class="mb-4">
  <h3 class="fw-bold mb-0">Kelola Bagian &amp; Petugas</h3>
  <p class="text-muted mb-0">Tambahkan bagian/departemen serta akun petugas yang akan menerima disposisi surat.</p>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white fw-semibold">Daftar Bagian</div>
      <ul class="list-group list-group-flush">
        <% bagianList.forEach(b => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= b.nama_bagian %> <span class="badge bg-secondary-subtle text-secondary ms-1"><%= b.kode %></span></span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">Tambah Bagian Baru</div>
      <div class="card-body">
        <form action="/bagian" method="POST" class="row g-2">
          <div class="col-7">
            <input type="text" name="nama_bagian" class="form-control form-control-sm" placeholder="Nama Bagian" required>
          </div>
          <div class="col-3">
            <input type="text" name="kode" class="form-control form-control-sm" placeholder="Kode" required>
          </div>
          <div class="col-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Tambah</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white fw-semibold">Daftar Akun Petugas</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead class="table-light"><tr><th>Nama</th><th>Username</th><th>Role</th><th>Bagian</th></tr></thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.nama %></td>
                <td><%= u.username %></td>
                <td><span class="badge <%= u.role === 'admin' ? 'bg-primary' : 'bg-secondary' %>"><%= u.role %></span></td>
                <td><%= bagianMap[u.bagian_id] || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">Tambah Akun Petugas</div>
      <div class="card-body">
        <form action="/bagian/users" method="POST" class="row g-2">
          <div class="col-md-6">
            <label class="form-label small mb-1">Nama Lengkap</label>
            <input type="text" name="nama" class="form-control form-control-sm" required>
          </div>
          <div class="col-md-6">
            <label class="form-label small mb-1">Username</label>
            <input type="text" name="username" class="form-control form-control-sm" required>
          </div>
          <div class="col-md-6">
            <label class="form-label small mb-1">Password</label>
            <input type="password" name="password" class="form-control form-control-sm" required>
          </div>
          <div class="col-md-6">
            <label class="form-label small mb-1">Role</label>
            <select name="role" class="form-select form-select-sm">
              <option value="petugas">Petugas Bagian</option>
              <option value="admin">Admin / Tata Usaha</option>
            </select>
          </div>
          <div class="col-md-12">
            <label class="form-label small mb-1">Bagian</label>
            <select name="bagian_id" class="form-select form-select-sm" required>
              <% bagianList.forEach(b => { %>
                <option value="<%= b.id %>"><%= b.nama_bagian %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 mt-2">
            <button type="submit" class="btn btn-sm btn-primary">Tambah Akun</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
