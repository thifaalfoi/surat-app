# URL koneksi Postgres (Neon / Vercel Postgres / Supabase / lainnya)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# String rahasia untuk menandatangani session login. Ganti dengan string acak yang panjang.
# Generate contoh: openssl rand -base64 32
JWT_SECRET=ganti-dengan-string-rahasia-yang-panjang-dan-acak

# Dipakai hanya oleh scripts/create-admin.mjs saat membuat user admin pertama kali
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
ADMIN_NAME=Administrator
